  "briefing": {
    "headline": "Monday Crop Progress opens a holiday week; hogs near $52",
    "lead": "Soybeans rallied 13 cents to $12.20¾ Friday while corn slipped 4½ cents to $4.34½, so beans pulled away from corn going into the holiday week. Hogs held at $52.60, with cattle steady at $223.",
    "teaser": "Crop Progress is Monday, Export Sales moves to Friday for Thanksgiving, and December hogs settled Friday at $52.60.",
    "one_number": {
      "value": "7.3%",
      "unit": "drop in cattle placements",
      "context": "Drovers reports feeder lot placements fell 7.3%, a sign fewer feeder calves are moving to feed yards."
    },
    "sections": [
      {
        "title": "Grains settle mixed Friday",
        "body": "- December corn settled Friday at **$4.34½**, down 4½ cents, while January soybeans gained 13¼ cents to $12.20¾.\n- December wheat settled at $5.74¼, down 4 cents.\n- Successful Farming's Friday recap called soybean gains double digit and livestock mixed.",
        "conviction_level": "low",
        "overnight_surprise": false
      },
      {
        "title": "Livestock mixed into the holiday",
        "body": "- December live cattle settled Friday at **$223.00**, up 0.1%, and January feeders were about unchanged at $335.425.\n- December lean hogs settled at $52.60, up 0.3%.\n- Drovers says placements fell 7.3% as feeder supplies tighten.",
        "conviction_level": "low",
        "overnight_surprise": false
      }
    ],
