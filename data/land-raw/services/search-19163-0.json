4074],[-90.41561683601621,41.6075259644195]],"categories":[],"spatialReference":"103046","accessInformation":"","classification":null,"licenseInfo":"","culture":"en-us","properties":null,"advancedSettings":null,"url":"https://services.arcgis.com/ovln19YRWV44nBqV/arcgis/rest/services/NFHL_2024_Affected/FeatureServer","proxyFilter":null,"access":"public","size":-1,"subInfo":0,"appCategories":[],"industries":[],"languages":[],"largeThumbnail":null,"banner":null,"screenshots":[],"listed":false,"numComments":0,"numRatings":0,"avgRating":0,"numViews":138,"scoreCompleteness":66,"groupDesignations":null,"apiToken1ExpirationDate":-1,"apiToken2ExpirationDate":-1,"lastViewed":1792198800000,"source":"Scott County Iowa"},{"id":"a788fb78300940c286fd554ea30e1548","owner":"Scott_County_IA_GIS","created":1767380158000,"modified":1767387484000,"guid":null,"name":"Topographic_Position_Index","title":"Topographic Position Index","type":"Feature Service","typeKeywords":["ArcGIS Server","Data","Feature Access","Feature Service","Metadata","Multilayer","Service","Hosted Service"],"description":"","tags":["Scott County","Iowa","TPI","CRS"],"snippet":"Topographic Position Index (TPI) and related layers for Scott County, Iowa used to display low areas near steep topography.","thumbnail":"thumbnail/thumbnail1767387483088.png","documentation":null,"extent":[[-90.91120207655025,41.445724607178214],[-90.30830841694682,41.77528954313552]],"categories":["/Categories/Planning"],"spatialReference":"26915","accessInformation":"","classification":null,"licenseInfo":"","culture":"en-us","properties":null,"advancedSettings":null,"url":"https://services.arcgis.com/ovln19YRWV44nBqV/arcgis/rest/services/Topographic_Position_Index/FeatureServer","proxyFilter":null,"access":"public","size":-1,"subInfo":0,"appCategories":[],"industries":[],"languages":[],"largeThumbnail":null,"banner":null,"screenshots":[],"listed":false,"numComments":0,"numRatings":0,"avgRating":0,"numViews":162,"contentStatus":"public_authoritative","orgId":"ovln19YRWV44nBqV","scoreCompleteness":66,"groupDesignations":null,"apiToken1ExpirationDate":-1,"apiToken2ExpirationDate":-1,"lastViewed":1792206000000,"source":"Scott County Iowa"},{"id":"8849782015f74b0cae1fee396fcb36fc","owner":"kkeeney-mcgurk","created":1680639023000,"modified":1680639033000,"guid":null,"name":"Parks_and_Open_Space","title":"Parks and Open Space","type":"Feature Service","typeKeywords":["ArcGIS Server","Data","Feature Access","Feature Service","Metadata","Service","Singlelayer","Hosted Service"],"description":"<div style='text-align:Left;'><div><div><p><span>This data is continuously updated to contain the most up to date open space areas. Open space refers to conservation/preservation, parks, and golf courses.<\/span><\/p><p><span>This data was originally created using a variety of sources, such as local counties, the DNR, UCLA Institute for Research, ESRI, and our own research. After adding the data to one shapefile, the data was meticulously reviewed by staff. Each boundary was inspected/corrected, gaps/overlap were eliminated, and the data fields were updated.<\/span><\/p><p><span>*Note: We cannot ensure 100% accuracy of this dataset. For instance, the data gathered from the DNR \"Conservation and Recreation Lands with Public Access in the State of Iowa\" shapefile was difficult to correct. We did not have enough information to fix most of these polygons so we left them 'as is'. When we compared these polygons to the parcel data, they did not seem to be entirely accurate.<\/span><\/p><\/div><\/div><\/div>","tags":["Parks","Recreation","Conservation","Preservation","Rock Island County","Mercer County","Henry County","Scott County","Muscatine County","Regional"],"snippet":"This data includes parks/recreation/conservation areas.. Updated November 2022.","thumbnail":"thumbnail/thumbnail.png","documentation":null,"extent":[[-91.36294826266221,41.0379257048665],[-89.82802291598192,41.80126916790841]],"categories":[],"spatialReference":"102676","accessInformation":"Bi-State Regional Commission (November 2020).","classification":null,"licenseInfo":"","culture":"en-us","properties":null,"advancedSettings":null,"url":"https://services6.arcgis.com/nNJLeOqxAgP4H4UY/arcgis/rest/services/Parks_and_Open_Space/FeatureServer","proxyFilter":null,"access":"public","size":-1,"subInfo":0,"appCategories":[],"industries":[],"languages":[],"largeThumbnail":null,"banner":null,"screenshots":[],"listed":false,"numComments":0,"numRatings":0,"avgRating":0,"numViews":1519,"scoreCompleteness":80,"groupDesignations":null,"apiToken1ExpirationDate":-1,"apiToken2ExpirationDate":-1,"lastViewed":1792195200000,"source":"Esri"},{"id":"617223fdbb3d4fbca928dd20c1cbf59c","owner":"kkeeney-mcgurk","created":1680638797000,"modified":1680638927000,"guid":null,"name":"Golf_Courses","title":"Golf Courses","type":"Feature Service","typeKeywords":["ArcGIS Server","Data","Feature Access","Feature Service","Metadata","Service","Singlelayer","Hosted Service"],"description":"<div style='text-align:Left;'><div><div><p><span>This data is continuously updated to contain the most up to date open space areas. Open space refers to conservation/preservation, parks, and golf courses.<\/span><\/p><p><span>This data was originally created using a variety of sources, such as local counties, the DNR, UCLA Institute for Research, ESRI, and our own research. After adding the data to one shapefile, the data was meticulously reviewed by staff. Each boundary was inspected/corrected, gaps/overlap were eliminated, and the data fields were updated.<\/span><\/p><p><span>*Note: We cannot ensure 100% accuracy of this dataset. For instance, the data gathered from the DNR \"Conservation and Recreation Lands with Public Access in the State of Iowa\" shapefile was difficult to correct. We did not have enough information to fix most of these polygons so we left them 'as is'. When we compared these polygons to the parcel data, they did not seem to be entirely accurate.<\/span><\/p><\/div><\/div><\/div>","tags":["Recreation","Golf Course","Rock Island County","Mercer County","Henry County","Scott County","Muscatine County","Regional"],"snippet":"This data includes golf courses. Updated November 2022.","thumbnail":"thumbnail/thumbnail1680638926524.png","documentation":null,"extent":[[-91.36294826266221,41.0379257048665],[-89.82802291598192,41.80126916790841]],"categories":[],"spatialReference":"102676","accessInformation":"Bi-State Regional Commission (November 2020).","classification":null,"licenseInfo":"","culture":"en-us","properties":null,"advancedSettings":null,"url":"https://services6.arcgis.com/nNJLeOqxAgP4H4UY/arcgis/rest/services/Golf_Courses/FeatureServer","proxyFilter":null,"access":"public","size":-1,"subInfo":0,"appCategories":[],"industries":[],"languages":[],"largeThumbnail":null,"banner":null,"screenshots":[],"listed":false,"numComments":0,"numRatings":0,"avgRating":0,"numViews":1452,"scoreCompleteness":80,"groupDesignations":null,"apiToken1ExpirationDate":-1,"apiToken2ExpirationDate":-1,"lastViewed":1792209600000,"source":"Esri"}]}