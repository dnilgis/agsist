oundary","Moline","East Moline","Carbon Cliff","Quad Cities","Contours","Tax Increment Finance Districts","TIF","Zoning","Parcels","Rock Island County"],"snippet":"Use this to load GIS layers to AGO maps and apps","thumbnail":"thumbnail/thumbnail.png","documentation":null,"extent":[[-90.73710570960374,41.328329166733305],[-90.1657829268395,41.69215530149193]],"categories":[],"spatialReference":"102100","accessInformation":"","classification":null,"licenseInfo":"","culture":"en-us","properties":null,"advancedSettings":null,"url":"https://services6.arcgis.com/iZ6GmQZ9zaRNfvWH/arcgis/rest/services/Silvis_Data_Loading_Map_New_WFL1/FeatureServer","proxyFilter":null,"access":"public","size":-1,"subInfo":0,"appCategories":[],"industries":[],"languages":[],"largeThumbnail":null,"banner":null,"screenshots":[],"listed":false,"numComments":0,"numRatings":0,"avgRating":0,"numViews":31089,"scoreCompleteness":66,"groupDesignations":null,"apiToken1ExpirationDate":-1,"apiToken2ExpirationDate":-1,"lastViewed":1792202400000,"source":"QCGIS Consulting, LLC"},{"id":"8849782015f74b0cae1fee396fcb36fc","owner":"kkeeney-mcgurk","created":1680639023000,"modified":1680639033000,"guid":null,"name":"Parks_and_Open_Space","title":"Parks and Open Space","type":"Feature Service","typeKeywords":["ArcGIS Server","Data","Feature Access","Feature Service","Metadata","Service","Singlelayer","Hosted Service"],"description":"<div style='text-align:Left;'><div><div><p><span>This data is continuously updated to contain the most up to date open space areas. Open space refers to conservation/preservation, parks, and golf courses.<\/span><\/p><p><span>This data was originally created using a variety of sources, such as local counties, the DNR, UCLA Institute for Research, ESRI, and our own research. After adding the data to one shapefile, the data was meticulously reviewed by staff. Each boundary was inspected/corrected, gaps/overlap were eliminated, and the data fields were updated.<\/span><\/p><p><span>*Note: We cannot ensure 100% accuracy of this dataset. For instance, the data gathered from the DNR \"Conservation and Recreation Lands with Public Access in the State of Iowa\" shapefile was difficult to correct. We did not have enough information to fix most of these polygons so we left them 'as is'. When we compared these polygons to the parcel data, they did not seem to be entirely accurate.<\/span><\/p><\/div><\/div><\/div>","tags":["Parks","Recreation","Conservation","Preservation","Rock Island County","Mercer County","Henry County","Scott County","Muscatine County","Regional"],"snippet":"This data includes parks/recreation/conservation areas.. Updated November 2022.","thumbnail":"thumbnail/thumbnail.png","documentation":null,"extent":[[-91.36294826266221,41.0379257048665],[-89.82802291598192,41.80126916790841]],"categories":[],"spatialReference":"102676","accessInformation":"Bi-State Regional Commission (November 2020).","classification":null,"licenseInfo":"","culture":"en-us","properties":null,"advancedSettings":null,"url":"https://services6.arcgis.com/nNJLeOqxAgP4H4UY/arcgis/rest/services/Parks_and_Open_Space/FeatureServer","proxyFilter":null,"access":"public","size":-1,"subInfo":0,"appCategories":[],"industries":[],"languages":[],"largeThumbnail":null,"banner":null,"screenshots":[],"listed":false,"numComments":0,"numRatings":0,"avgRating":0,"numViews":1519,"scoreCompleteness":80,"groupDesignations":null,"apiToken1ExpirationDate":-1,"apiToken2ExpirationDate":-1,"lastViewed":1792195200000,"source":"Esri"},{"id":"617223fdbb3d4fbca928dd20c1cbf59c","owner":"kkeeney-mcgurk","created":1680638797000,"modified":1680638927000,"guid":null,"name":"Golf_Courses","title":"Golf Courses","type":"Feature Service","typeKeywords":["ArcGIS Server","Data","Feature Access","Feature Service","Metadata","Service","Singlelayer","Hosted Service"],"description":"<div style='text-align:Left;'><div><div><p><span>This data is continuously updated to contain the most up to date open space areas. Open space refers to conservation/preservation, parks, and golf courses.<\/span><\/p><p><span>This data was originally created using a variety of sources, such as local counties, the DNR, UCLA Institute for Research, ESRI, and our own research. After adding the data to one shapefile, the data was meticulously reviewed by staff. Each boundary was inspected/corrected, gaps/overlap were eliminated, and the data fields were updated.<\/span><\/p><p><span>*Note: We cannot ensure 100% accuracy of this dataset. For instance, the data gathered from the DNR \"Conservation and Recreation Lands with Public Access in the State of Iowa\" shapefile was difficult to correct. We did not have enough information to fix most of these polygons so we left them 'as is'. When we compared these polygons to the parcel data, they did not seem to be entirely accurate.<\/span><\/p><\/div><\/div><\/div>","tags":["Recreation","Golf Course","Rock Island County","Mercer County","Henry County","Scott County","Muscatine County","Regional"],"snippet":"This data includes golf courses. Updated November 2022.","thumbnail":"thumbnail/thumbnail1680638926524.png","documentation":null,"extent":[[-91.36294826266221,41.0379257048665],[-89.82802291598192,41.80126916790841]],"categories":[],"spatialReference":"102676","accessInformation":"Bi-State Regional Commission (November 2020).","classification":null,"licenseInfo":"","culture":"en-us","properties":null,"advancedSettings":null,"url":"https://services6.arcgis.com/nNJLeOqxAgP4H4UY/arcgis/rest/services/Golf_Courses/FeatureServer","proxyFilter":null,"access":"public","size":-1,"subInfo":0,"appCategories":[],"industries":[],"languages":[],"largeThumbnail":null,"banner":null,"screenshots":[],"listed":false,"numComments":0,"numRatings":0,"avgRating":0,"numViews":1452,"scoreCompleteness":80,"groupDesignations":null,"apiToken1ExpirationDate":-1,"apiToken2ExpirationDate":-1,"lastViewed":1792195200000,"source":"Esri"},{"id":"192f7ecee77d459c8c29cec950a9452f","o