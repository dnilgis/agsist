__pycache__/
*.pyc
.DS_Store
# The full national pull. Written by fetch_bids.py for build_basis_map.py and
# build_basis_history.py to read in the same job, then thrown away with the
# runner. About 6 MB. The workflow only ever `git add`s explicit paths, so this
# has never actually been committed -- but the comments have called it
# gitignored since 2026-08-19 and it was not, and one `git add -A` by hand
# would have put 6 MB into the repo. Now the claim is true.
bids-full.json


# Daily cash bid snapshots: built in the fetch_bids job and saved to the raw
# branch (scripts/bid_snapshots.py, scripts/push_raw.sh), never to main.
/bids-daily/
/bids-daily-flags/
# Private basis forecast ledger (scripts/basis_ledger.py): raw branch only, never main.
/basis-ledger/

# private, never published (2026-10-12)
data/signups.json
data/seo-opportunities.json
data/seo-index.json
build/shots/

# Raw build inputs no page reads live on the `raw` branch (never deployed),
# not main (2026-10-16; data/ was at 290 of its 300 MB budget). The workflows
# write them here and save them with scripts/push_raw.sh; farmland-atlas.yml
# unpacks data/atlas/raw with scripts/pull_raw.sh and then runs
# `git add -A data/atlas`, which would put 71 MB back on main without these.
# Kept on main on purpose: each probe's listing.json (the normal run reads it).
# Oct 29 (fx/sizeinputs): data/atlas/raw/drought.json moved to raw too (the
# Atlas pulls it with the folder; the PR checks pull it for the drought test),
# and so did the two CRP workbooks in data/atlas/src/ and data/site-inventory.json.
/data/atlas/raw/*
/data/atlas/src/
/data/site-inventory.json
# daily.yml saves each run's fact check to raw (daily-fact-check/), never main
/daily-fact-check/
/data/cattle-auction-raw/*
!/data/cattle-auction-raw/listing.json
/data/coop-fert-raw/
/data/hay-ams-raw/*
!/data/hay-ams-raw/listing.json
/data/cattle-cash-raw/
/data/hog-cash-raw/
/data/planting-normals-raw/
/data/ccc-loan-raw/
/data/dairy-raw/
/data/fall-nitrogen-raw/
/data/fert-ams-raw/
/data/hay-raw/
/data/drought/probe/
/data/land-raw/
# Schrader capture (schrader-capture.yml): raw feed and result pages, saved to the raw branch only.
/land/schrader/
# Land auction firms capture (schrader-capture.yml, firms jobs): raw results pages, raw branch only.
/land/wieman/
/land/younger/
/land/horning/
/land/martins/
# FSA's ARC/PLC program files (xlsx/pdf, 34 MB, Oct 20): read only by
# scripts/build_arc_plc.py, linked by no page. They live on raw at the same
# path; arc-plc-refresh.yml and scripts/dev/checks.sh unpack them with
# `bash scripts/pull_raw.sh data/fsa`. The URL list (it triggers
# fetch-fsa-files.yml) and the download manifest stay on main.
/data/fsa/*
!/data/fsa/urls.txt
!/data/fsa/manifest.tsv

# Working notes live in the private repo, never here.
# A stray copy unpacked here is never committed.
/.claude/notes/

# Session skills live in the private repo at .claude/skills, off the public
# repo. A session that adds that repo loads them.
/.claude/skills/

# Job files no page reads, unpacked from (and saved to) the private repo's
# private-data branch: job health, render audit, withheld bid rows, the
# Daily's editorial notes (Oct 20, 2026).
/private/

# Raw history for the insight machine (Oct 21): written in the runner by
# scripts/backfill_*.py and scripts/history_append.py, saved to the private raw
# branch with scripts/push_raw.sh, never to main.
/history/
# Daily point-in-time copies of outside data (Oct 28): written in the runner by
# scripts/vintage.py, saved to the private raw branch by vintage.yml, never main.
/vintage/

# scripts/dev/verify.sh writes its last test run here for the Stop hook (Oct 22); per checkout, never committed
/.verify/
# implied futures shadow test: ticks live on the private raw branch only (implied-futures.yml)
/data/implied-futures/
# Builder-only data (Nov 4,; no page,
# component, worker or other repo loads them). Each producing job saves it with
# scripts/push_raw.sh and every job that reads it unpacks it first with
# scripts/pull_raw.sh; test/raw-readers.test.mjs holds the list and checks both.
# site-usage.json: 90 days of Search Console queries (private). cot-deep.json:
# the twenty-year COT history behind data/cot-analysis.json.
/data/site-usage.json
/data/cot-deep.json

# Share images live in dnilgis/agsist-data since Nov 4, 2026 (scripts/share_host.py); never commit them here
/farmland-atlas/og/
/data/social/
# Florida's prepared sale files: read from the private raw branch by land-data.yml, never committed (Nov 5, 2026)
/data/land-src/
# agsist-data's land folder (Florida's county files), linked here only while a job builds from it (scripts/build_land_summary.py HOSTED)
/data/land-hosted
# River key inputs (river-pull.yml, one time): saved to the raw branch, never main
/river/
